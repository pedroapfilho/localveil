{
  "name": "cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "localveil": "./bin/localveil.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules coverage",
    "dev": "tsx src/cli.tsx",
    "lint": "oxlint bin src",
    "start": "tsx src/cli.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/i18n": "workspace:*",
    "@repo/redact-core": "workspace:*",
    "@repo/redact-node": "workspace:*",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
