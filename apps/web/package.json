{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "portless run --name localveil.web vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/i18n": "workspace:*",
    "@repo/pii-detect": "workspace:*",
    "@repo/redact-core": "workspace:*",
    "@repo/redact-image": "workspace:*",
    "@repo/redact-pdf": "workspace:*",
    "@repo/redact-text": "workspace:*",
    "@repo/ui": "workspace:*",
    "lucide-react": "^1.34.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "workerpool": "^10.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "onnxruntime-web": "1.29.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
