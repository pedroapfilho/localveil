{
  "name": "@repo/redact",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#pdfjs": {
      "node": "pdfjs-dist/legacy/build/pdf.mjs",
      "default": "pdfjs-dist"
    },
    "#pdfjs-worker": {
      "types": "./src/pdf/pdfjs-worker.d.ts",
      "node": "pdfjs-dist/legacy/build/pdf.worker.mjs",
      "default": "pdfjs-dist/build/pdf.worker.mjs"
    },
    "#standard-fonts": {
      "node": "./src/pdf/standard-fonts-node.ts",
      "default": "./src/pdf/standard-fonts.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./redactors": "./src/formats/redactors.ts",
    "./text": "./src/text/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@repo/redact-core": "workspace:*",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
