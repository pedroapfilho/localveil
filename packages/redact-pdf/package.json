{
  "name": "@repo/redact-pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#pdfjs": {
      "node": "pdfjs-dist/legacy/build/pdf.mjs",
      "default": "pdfjs-dist"
    },
    "#pdfjs-worker": {
      "node": "pdfjs-dist/legacy/build/pdf.worker.mjs",
      "default": "pdfjs-dist/build/pdf.worker.mjs"
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/ocr": "workspace:*",
    "@repo/redact-core": "workspace:*",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
