{
  "name": "localveil",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit --base main",
    "prepare": "husky"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "fallow": "^3.19.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-config-awesomeness": "^4.4.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
