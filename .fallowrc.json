{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "oxlint.config.ts",
    "apps/web/src/main.tsx",
    "apps/web/src/redact-worker.ts",
    "packages/pii-detect/src/ort-browser.ts"
  ],
  "ignoreDependencies": ["@vitest/coverage-v8", "jsdom", "react-dom"],
  "ignoreUnresolvedImports": ["postcss-load-config"],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "rules": {
    "private-type-leaks": "off"
  },
  "usedClassMembers": ["add*Filter", "createSelectionStyle", "create", "reset", "destroy"]
}
