{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "oxlint.config.ts",
    "apps/web/src/main.tsx",
    "apps/web/src/redact-worker.ts",
    "packages/pii-detect/src/model-store-browser.ts",
    "packages/pii-detect/src/ort-browser.ts",
    "apps/cli/src/file-worker.ts",
    "apps/web/src/wasm-check.ts",
    "packages/redact-pdf/src/standard-fonts.ts"
  ],
  "ignoreDependencies": ["@shadcn/lint", "@vitest/coverage-v8", "jsdom", "react-dom"],
  "ignoreUnresolvedImports": ["postcss-load-config"],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "rules": {
    "private-type-leaks": "off"
  },
  "usedClassMembers": ["add*Filter", "createSelectionStyle", "create", "reset", "destroy", "fetch"],
  "ignorePatterns": [".github/ci/*.mjs"],
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "autoDiscover": ["apps"]
      },
      {
        "name": "package",
        "patterns": ["packages/**"]
      }
    ],
    "rules": [
      {
        "from": "package",
        "allow": ["package"]
      },
      {
        "from": "app",
        "allow": ["package"]
      }
    ]
  }
}
